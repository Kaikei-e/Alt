{
  "alt-agent-harness": {
    "SessionStart": [
      {
        "type": "command",
        "command": "\"$(git rev-parse --show-toplevel)/scripts/altharness/alt-harness\" agy-hook session-start",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|Bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/altharness/alt-harness\" agy-hook pre-shell",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|Edit|Write|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/altharness/alt-harness\" agy-hook pre-edit",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|Edit|Write|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/altharness/alt-harness\" agy-hook post-edit",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"$(git rev-parse --show-toplevel)/scripts/altharness/alt-harness\" agy-hook stop",
        "timeout": 30
      }
    ]
  }
}
