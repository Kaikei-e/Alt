# Keep Docker's ABI so network includes Unix socket permissions on AppArmor 5.
abi <abi/3.0>,
#include <tunables/global>

# Custom Docker AppArmor profile for Alt PostgreSQL containers on Ubuntu 26.04+.
# Derived from Moby profiles/apparmor/template.go (docker-default baseTemplate).
#
# Why this profile exists:
#   On Ubuntu 26.04 with kernel.apparmor_restrict_unprivileged_unconfined=1,
#   runc transitions into container profiles via change_onexec without
#   CAP_MAC_OVERRIDE, producing a stacked label:
#     alt-docker-postgres//&unconfined
#   Docker's built-in template only permits `signal (send,receive) peer={{.Name}},`
#   which denies intra-container PostgreSQL postmaster/worker signals under the
#   stacked peer label (see containerd/containerd#14485, PR #14487).
#
# Daemon / runtime signal peer note:
#   Depending on host packaging, stop/kill signals from the container runtime
#   arrive from peer=unconfined, peer=runc (Ubuntu named-unconfined runc
#   profile), peer=dockerd, or peer=/usr/bin/dockerd. If a host uses a custom
#   daemon profile (e.g. snap or custom path), add its peer name below.

profile alt-docker-postgres flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  # Preserve Docker's crypto-API and host/guest socket restrictions.
  deny network alg,
  deny network vsock,
  capability,
  file,
  umount,

  # Host (privileged) and container-runtime processes may send signals to container processes.
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=dockerd,
  signal (receive) peer=/usr/bin/dockerd,

  # Container processes may send signals amongst themselves (literal + stacked peers).
  signal (send,receive) peer=alt-docker-postgres,
  signal (send,receive) peer=alt-docker-postgres//&unconfined,
  signal (send,receive) peer=unconfined//&alt-docker-postgres,

  # Deny rules preserved verbatim from Docker Engine baseTemplate.
  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # Suppress ptrace denials when using 'docker ps' or 'ps' inside the same profile scope.
  ptrace (trace,read,tracedby,readby) peer=alt-docker-postgres,
}
