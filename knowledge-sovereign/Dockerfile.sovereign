FROM golang:1.26-alpine@sha256:70b46548e42db77e0966aaf3619fd068734dc6c77584d526b91126504fd95816 AS builder

WORKDIR /app

# 依存関係キャッシュ最適化
COPY ./app/go.mod ./app/go.sum ./
RUN go mod download

COPY ./app .

# 最適化ビルド: シンボル除去 + 静的リンク
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /app/server ./main.go

# 静的 wget バイナリ取得 (ヘルスチェック用)
FROM busybox:1.36-musl AS busybox

# 最小イメージ (distroless/static) + 非rootユーザー
FROM gcr.io/distroless/static-debian12:nonroot@sha256:d093aa3e30dbadd3efe1310db061a14da60299baff8450a17fe0ccc514a16639

COPY --from=busybox /bin/wget /usr/bin/wget
COPY --from=busybox /bin/sh /bin/sh
COPY --from=busybox /bin/cat /bin/cat

COPY --from=builder /app/server /server
COPY --from=busybox /bin/mkdir /bin/mkdir

# Pre-create snapshot dir before dropping to nonroot
RUN ["/bin/mkdir", "-p", "/tmp/snapshots"]

USER nonroot:nonroot

EXPOSE 9500 9501

ENTRYPOINT ["/server"]
