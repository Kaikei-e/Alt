%% Alt システム構成図（日本語版）
%% README.md の "How it works" にある全体図と同じ構成
flowchart TB
    you(["あなた<br/>ブラウザ / PWA"])
    edge["<b>エッジと認証</b><br/>plecto-proxy · Ory Kratos<br/>auth-hub"]
    surface["<b>プロダクト画面</b><br/>alt-frontend-sv<br/>alt-butterfly-facade"]
    core["<b>コア基盤</b><br/>alt-backend · alt-data-hub<br/>knowledge-sovereign<br/>mq-hub · alt-harvester<br/>alt-notifier"]
    intel["<b>インテリジェンス</b><br/>rag-orchestrator<br/>recap-worker<br/>acolyte-orchestrator"]
    enrich["<b>取り込みと付加情報</b><br/>pre-processor<br/>tag-generator<br/>search-indexer"]
    infer["<b>ローカル推論</b><br/>news-creator · Ollama<br/>knowledge-embedder<br/>rerank-server"]
    data[("<b>データ</b><br/>ドメイン別 PostgreSQL<br/>Redis Streams<br/>Meilisearch · ClickHouse")]
    obs["<b>可観測性</b><br/>rask-log-forwarder<br/>rask-log-aggregator<br/>Prometheus · Grafana"]

    you -->|"HTTPS"| edge --> surface
    surface -->|"Connect-RPC"| core
    core -->|"mTLS 上の Connect-RPC"| intel
    core -->|"Redis Streams のイベント"| enrich
    intel -->|"プロンプトと埋め込み"| infer
    enrich --> infer
    core & intel & enrich --> data
    obs -.->|"全サービスの<br/>ログとメトリクス"| data
