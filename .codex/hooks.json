{
  "description": "ADR preflight gate: validates the DocDag ADR graph at session start and shows binding ADRs before the first edit in each top-level directory.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/skills/adr-preflight/scripts/adr_preflight.py\" --hook",
            "timeout": 30,
            "statusMessage": "Validating the ADR graph"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-harness/harness_selfcheck.py\" --hook",
            "timeout": 30,
            "statusMessage": "Running agent harness self-check"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/skills/adr-preflight/scripts/adr_preflight.py\" --hook",
            "timeout": 30,
            "statusMessage": "Running ADR preflight"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-harness/guard_protected_paths.py\"",
            "timeout": 10,
            "statusMessage": "Checking protected paths"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-harness/guard_event_time.py\"",
            "timeout": 10,
            "statusMessage": "Checking projector event-time invariants"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-harness/guard_ops_commands.py\" --on-match deny",
            "timeout": 10,
            "statusMessage": "Checking container and compose commands"
          }
        ]
      }
    ]
  }
}
