{
  "description": "ADR-first preflight gate: validates the DocDag ADR graph at session start and blocks production edits until a valid new/updated docs/ADR/NNNNNN.md exists (tests and docs/ exempt).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/altharness/alt-harness\" preflight --hook",
            "timeout": 30,
            "statusMessage": "Validating the ADR graph"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/altharness/alt-harness\" selfcheck --hook",
            "timeout": 30,
            "statusMessage": "Running agent harness self-check"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/altharness/alt-harness\" preflight --hook",
            "timeout": 30,
            "statusMessage": "Running ADR preflight"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/altharness/alt-harness\" guard-protected",
            "timeout": 10,
            "statusMessage": "Checking protected paths"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/altharness/alt-harness\" guard-event-time",
            "timeout": 10,
            "statusMessage": "Checking projector event-time invariants"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/altharness/alt-harness\" guard-scope",
            "timeout": 10,
            "statusMessage": "Checking generated-code and packet-scope boundaries"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/altharness/alt-harness\" guard-ops --on-match deny",
            "timeout": 10,
            "statusMessage": "Checking container and compose commands"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/altharness/alt-harness\" guard-exec",
            "timeout": 10,
            "statusMessage": "Checking unsafe autofix and worker execution commands"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/altharness/alt-harness\" guard-adr-read",
            "timeout": 10,
            "statusMessage": "Checking shell ADR reads"
          }
        ]
      }
    ]
  }
}
