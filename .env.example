# Alt Platform Environment Variables
# Copy this file to .env and fill in the values
#
# SECURITY NOTE: This file should NOT contain actual secrets.
# All sensitive values should be stored in secrets/ directory as individual files.
# The compose files use Docker Secrets pattern (_FILE suffix) for sensitive data.

# =============================================================================
# DATABASE CONFIGURATION (non-sensitive)
# =============================================================================
POSTGRES_DB=alt
POSTGRES_USER=alt_user
DB_HOST=db
DB_PORT=5432
DB_USER=alt_user
DB_NAME=alt

# Pre-processor database user (non-sensitive)
PRE_PROCESSOR_DB_USER=pre_processor
PRE_PROCESSOR_SIDECAR_DB_USER=pre_processor_sidecar

# Search indexer database user (non-sensitive)
SEARCH_INDEXER_DB_USER=search_indexer

# =============================================================================
# PRE-PROCESSOR DATABASE CONFIGURATION (non-sensitive, ADR-000246)
# =============================================================================
PP_DB_NAME=pre_processor
PP_DB_USER=pp_user
PP_DB_PORT=5437

# =============================================================================
# RECAP DATABASE CONFIGURATION (non-sensitive)
# =============================================================================
RECAP_DB_NAME=recap
RECAP_DB_USER=recap_user
RECAP_DB_PORT=5432

# =============================================================================
# RAG DATABASE CONFIGURATION (non-sensitive)
# =============================================================================
RAG_DB_NAME=rag
RAG_DB_USER=rag_user
RAG_DB_PORT=5436

# =============================================================================
# CLICKHOUSE CONFIGURATION (non-sensitive)
# =============================================================================
CLICKHOUSE_DB=rask_logs
CLICKHOUSE_USER=rask_user

# =============================================================================
# APPLICATION CONFIGURATION (non-sensitive)
# =============================================================================
NEXT_PUBLIC_APP_ORIGIN=http://localhost
NEXT_PUBLIC_IDP_ORIGIN=http://localhost
NEXT_PUBLIC_KRATOS_PUBLIC_URL=http://localhost/ory
NEXT_PUBLIC_RETURN_TO_DEFAULT=/dashboard
KRATOS_INTERNAL_URL=http://kratos:4433
KRATOS_PUBLIC_URL=http://localhost/ory
# Session cookie domain. Required: compose refuses to render when it is unset.
# Empty means host-only cookies (local development); a deployment that serves
# several subdomains sets the parent domain with a leading dot, e.g. .example.com
KRATOS_COOKIE_DOMAIN=
# auth-hub serves session endpoints over TLS on :8443; :8888 answers /health only.
AUTH_HUB_INTERNAL_URL=https://auth-hub:8443
ALT_BACKEND_BASE_URL=http://alt-backend:9000

# alt-backend deployment environment. One of: development | staging | production.
# Anything else is rejected at startup so a typo cannot silently buy the
# permissive development behaviour of the environment-keyed guards.
APP_ENV=development

# alt-backend OGP image proxy. Enabled by default; when enabled it REQUIRES a
# non-empty secret (secrets/image_proxy_secret.txt, mounted as
# IMAGE_PROXY_SECRET_FILE) or alt-backend exits non-zero at startup.
# Set IMAGE_PROXY_ENABLED=false to turn the proxy off explicitly instead.
IMAGE_PROXY_ENABLED=true

# Meilisearch endpoint search-indexer talks to. Required: compose interpolates
# it with no default. The keys come from secrets/meili_master_key.txt and
# secrets/meili_search_key.txt.
MEILISEARCH_HOST=http://meilisearch:7700

# =============================================================================
# SECRETS (stored in secrets/ directory)
# =============================================================================
# The following secrets must be created as files in the secrets/ directory:
#
# secrets/postgres_password.txt        - PostgreSQL superuser password
# secrets/db_password.txt              - Application database password
# secrets/pre_processor_db_password.txt - Pre-processor service DB password
# secrets/pre_processor_sidecar_db_password.txt - Pre-processor sidecar DB password
# secrets/search_indexer_db_password.txt - Search indexer service DB password
# secrets/recap_db_password.txt        - Recap database password
# secrets/rag_db_password.txt          - RAG database password
# secrets/kratos_db_password.txt       - Kratos database password
# secrets/kratos_cookie_secret.txt     - Kratos cookie encryption secret
# secrets/kratos_cipher_secret.txt     - Kratos cipher secret
# secrets/meili_master_key.txt         - Meilisearch master key
# secrets/clickhouse_password.txt      - ClickHouse password
# secrets/csrf_secret.txt              - CSRF token secret (min 32 chars)
# secrets/service_secret.txt           - Inter-service authentication secret
# secrets/auth_shared_secret.txt       - Auth shared secret
# secrets/backend_token_signing_key.txt - Backend token Ed25519 private key, PKCS#8 PEM (auth-hub only).
#                                        Generated by the setup CLI as a key pair, not by `openssl rand`.
# secrets/backend_token_verify_key.txt  - Matching Ed25519 public key, SPKI PEM (token verifiers)
# secrets/redis_streams_producer_password.txt - Redis streams producer user password (mq-hub)
# secrets/redis_streams_consumer_password.txt - Redis streams consumer user password (pre-processor,
#                                        search-indexer, tag-generator); must differ from the producer's
# secrets/image_proxy_secret.txt       - OGP image proxy URL signing secret
#                                        (required unless IMAGE_PROXY_ENABLED=false)
# secrets/hugging_face_token.txt       - Hugging Face API token
# secrets/inoreader_client_id.txt      - Inoreader OAuth client ID
# secrets/inoreader_client_secret.txt  - Inoreader OAuth client secret
# secrets/pp_db_password.txt           - Pre-processor dedicated DB password
# secrets/deadman_ping_url.txt         - Off-host heartbeat URL for the
#                                        Alertmanager Watchdog receiver.
#                                        Operator-provided, not generated:
#                                        without it the alertmanager container
#                                        refuses to start.
#
# Generate secure random secrets:
#   openssl rand -base64 32 > secrets/csrf_secret.txt
#   openssl rand -base64 32 > secrets/service_secret.txt
#   # etc.

# =============================================================================
# PULL-BASED DEPLOY CONFIGURATION
# =============================================================================
# GitHub Container Registry owner. Services that have migrated to pull-based
# deploy reference images as ghcr.io/${GHCR_OWNER}/alt-<service>:${IMAGE_TAG}.
GHCR_OWNER=kaikei-e

# Image tag compose pulls. CI sets this to sha-<short> per release. Default
# `main` lets local `docker compose pull` grab the branch-tip rebuild.
IMAGE_TAG=main

# Tailscale IP of the prod host (this machine). The alt-builder runner on
# the separate host reaches the Pact Broker at http://${PROD_TAILNET_IP}:9292.
# Populate from `tailscale ip -4` on this host. Leave unset (127.0.0.1) to
# keep the Broker loopback-only.
PROD_TAILNET_IP=127.0.0.1

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================
# Docker group ID for log forwarders
DOCKER_GROUP_ID=984

# Nginx target for log forwarding
NGINX_TARGET=nginx

# Backend target for log forwarding
ALT_BACKEND_TARGET=alt-backend

# Atlas migration environment
ATLAS_ENV=kubernetes

# Tag label graph settings
TAG_LABEL_GRAPH_WINDOW=7d
TAG_LABEL_GRAPH_TTL_SECONDS=3600

# Recap subworker settings
RECAP_SUBWORKER_DEVICE=cuda
RECAP_SUBWORKER_BATCH_SIZE=32
RECAP_SUBWORKER_BAYES_OPT_TRIALS=15
RECAP_SUBWORKER_MODEL_BACKEND=sentence-transformers
RECAP_SUBWORKER_MODEL_ID=intfloat/multilingual-e5-large

# Knowledge-loop owner for recap-worker's recap.topic_snapshotted.v1 emit.
# Compose defaults RECAP_KNOWLEDGE_EMIT to true, and emit=true requires BOTH
# owner UUIDs — recap-worker refuses to start on a half-wired pair. Set the
# deployment's owner ids here, or set RECAP_KNOWLEDGE_EMIT=false explicitly.
RECAP_KNOWLEDGE_OWNER_USER_ID=
RECAP_KNOWLEDGE_OWNER_TENANT_ID=
RECAP_KNOWLEDGE_EMIT=false

# Owner UUID for recap-worker's cards batch job and evaluation replay read-history queries.
# Required when RECAP_CARDS_JOB=enabled or when running `recap-worker eval replay`.
RECAP_CARDS_USER_ID=

# New-account registration is closed by default; a fresh install sets this to true, registers its first account, then sets it back to false.
KRATOS_REGISTRATION_ENABLED=false

# Knowledge Home Feature Flags
KNOWLEDGE_HOME_ENABLE_PAGE=true
KNOWLEDGE_HOME_ENABLE_TRACKING=true
KNOWLEDGE_HOME_ENABLE_PROJECTION_V2=true
KNOWLEDGE_HOME_ROLLOUT_PERCENTAGE=100
KNOWLEDGE_HOME_ALLOWED_USER_IDS=
KNOWLEDGE_HOME_ENABLE_LENS=true
KNOWLEDGE_HOME_ENABLE_STREAM_UPDATES=true
KNOWLEDGE_HOME_ENABLE_SUPERSEDE_UX=true

# News Creator / Distributed BE Dispatch
# Offload batch summarization to OpenAI-compatible LLM gateway targets (<base_url>|<model>|<num_ctx>).
# Example: DISTRIBUTED_BE_TARGETS=http://llm-gateway.example:8080|provider-a/model-a|8192
DISTRIBUTED_BE_ENABLED=false
DISTRIBUTED_BE_TARGETS=
DISTRIBUTED_BE_REASONING_EFFORT=
DISTRIBUTED_BE_HEALTH_INTERVAL_SECONDS=30
DISTRIBUTED_BE_TIMEOUT_SECONDS=300
DISTRIBUTED_BE_COOLDOWN_SECONDS=60

# Admin Observability (Prometheus-backed Admin UI)
# Flip to true in dev/staging to surface Prometheus metrics in /admin/knowledge-home.
ADMIN_MONITOR_ENABLED=false
ADMIN_MONITOR_PROMETHEUS_URL=http://prometheus:9090
ADMIN_MONITOR_QUERY_TIMEOUT=3s
ADMIN_MONITOR_CACHE_TTL=10s
ADMIN_MONITOR_RATE_LIMIT_RPS=5
ADMIN_MONITOR_RATE_LIMIT_BURST=10
ADMIN_MONITOR_STREAM_INTERVAL=5s
