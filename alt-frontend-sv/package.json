{
	"name": "alt-frontend-sv",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:mock": "concurrently -k -n mock,vite \"bun run mock-server\" \"bun run dev --host\"",
		"dev:remote": "bun dev --host 0.0.0.0",
		"mock-server": "bunx tsx tests/e2e/infra/mock-server.ts",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p ./src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome lint --write",
		"format": "biome format --write",
		"test": "vitest run",
		"test:server": "vitest run --project=server",
		"test:client": "VITEST_BROWSER=true vitest run --project=client",
		"test:all": "VITEST_BROWSER=true vitest run",
		"test:watch": "vitest --watch",
		"test:e2e": "bun run build && npx playwright test --reporter=list",
		"test:e2e:ui": "npx playwright test --ui",
		"test:e2e:integration": "npx playwright test --project=integration --reporter=list",
		"test:coverage": "vitest run --coverage",
		"build:analyze": "ANALYZE=true vite build && echo 'Bundle report: stats.html'"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.17.0",
		"@connectrpc/connect": "^2.3.0",
		"@connectrpc/connect-web": "^2.3.0",
		"@ory/client": "^1.22.66",
		"@tanstack/svelte-query": "^6.3.11",
		"@threlte/core": "^8.7.0",
		"@threlte/extras": "^9.23.1",
		"bits-ui": "^2.20.6",
		"chart.js": "^4.6.1",
		"clsx": "^2.1.1",
		"isomorphic-dompurify": "^3.19.0",
		"svelte-chartjs": "^4.0.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.2.2",
		"three": "^0.187.0",
		"three-mesh-bvh": "^0.9.18",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.5",
		"@bufbuild/protoc-gen-es": "^2.17.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.69.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.6",
		"@types/three": "^0.187.0",
		"@vitest/browser": "~4.1.12",
		"@vitest/browser-playwright": "~4.1.12",
		"axe-core": "^4.14.0",
		"axe-playwright": "^2.2.2",
		"concurrently": "^10.0.6",
		"jsdom": "^29.1.1",
		"msw": "^2.14.6",
		"rollup-plugin-visualizer": "^7.1.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "~8.3.6",
		"vitest": "~4.1.12",
		"vitest-browser-svelte": "^2.2.0"
	},
	"overrides": {
		"axios": "~1.20.0",
		"devalue": "^5.9.2",
		"dompurify": "~3.4.16",
		"fflate": "^0.8.3",
		"follow-redirects": "~1.16.3",
		"form-data": "^4.0.6",
		"lodash": "^4.18.0",
		"nanoid": "^3.3.18",
		"picomatch": "^4.0.4",
		"postcss": "^8.5.18",
		"sharp": "~0.35.5",
		"shell-quote": "~1.12.0",
		"source-map-js": "~1.2.2",
		"undici": "~7.30.1",
		"ws": "^8.21.0"
	},
	"imports": {
		"#lib/*.js": "./src/lib/*.ts",
		"#lib/*": "./src/lib/*"
	}
}
