{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src", "tests", "*"],
	"exclude": ["src/service-worker", "tests/**/*.js", "tests/**/*.cjs"]
}
