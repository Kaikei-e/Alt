{
	"$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!playwright-report",
			"!test-results",
			"!docs",
			"!src/lib/gen"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"nursery": {
				"noFloatingPromises": "warn",
				"noMisusedPromises": "warn",
				"noPlaywrightElementHandle": "error",
				"noPlaywrightEval": "error",
				"noPlaywrightForceOption": "error",
				"noPlaywrightMissingAwait": "error",
				"noPlaywrightNetworkidle": "warn",
				"noPlaywrightPagePause": "error",
				"noPlaywrightUselessAwait": "warn",
				"noPlaywrightWaitForNavigation": "error",
				"noPlaywrightWaitForSelector": "error",
				"noPlaywrightWaitForTimeout": "warn",
				"useExhaustiveSwitchCases": "error",
				"usePlaywrightValidDescribeCallback": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"cssModules": true,
			"allowWrongLineComments": true,
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": {
							"level": "off",
							"options": {
								"ignoreRestSiblings": true
							}
						}
					},
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"suspicious": {
						"noDoubleEquals": "off"
					},
					"a11y": {
						"useKeyWithClickEvents": "off"
					}
				}
			}
		},
		{
			"includes": ["src/lib/domain/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"#lib/hooks/*",
											"#lib/stores/*",
											"#lib/api/*",
											"#lib/connect/*",
											"#lib/queries/*",
											"#lib/components/*",
											"#lib/server/*"
										]
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
