#!/usr/bin/env bash
# Builds scripts/altharness/bin/alt-harness when sources change, then execs it.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
mod="$root/scripts/altharness"
bin_dir="$mod/bin"
orig_bin="$bin_dir/alt-harness"
bin="$orig_bin"
stamp_file="$bin_dir/.alt-harness.stamp"
lock_file="$bin_dir/.alt-harness.lock"
cmd_name="${1:-}"
sub_cmd="${2:-}"

fail_exit() {
  case "$cmd_name" in
    guard-*|agy-hook*)
      local lkg=""
      if [ -x "$bin" ]; then
        lkg="$bin"
      elif [ -x "$orig_bin" ]; then
        lkg="$orig_bin"
      fi
      if [ -n "$lkg" ]; then
        echo "WARN: alt-harness rebuild failed; falling back to last-known-good binary: $lkg" >&2
        exec "$lkg" "$@"
      fi
      ;;
  esac
  case "$cmd_name" in
    guard-*)
      exit 2
      ;;
    agy-hook*)
      case "$sub_cmd" in
        post-edit)
          printf '{}\n'
          ;;
        session-start)
          printf '{"injectSteps":[]}\n'
          ;;
        stop)
          printf '{"decision":"allow"}\n'
          ;;
        pre-shell|pre-edit|*)
          printf '{"decision":"deny","reason":"BLOCKED: alt-harness build failed"}\n'
          ;;
      esac
      exit 0
      ;;
    *)
      exit 1
      ;;
  esac
}

compute_stamp() {
  local listing=""
  if listing="$(find "$mod" -maxdepth 4 -type f \( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' \) -printf '%P %T@ %s\n' 2>/dev/null)"; then
    printf '%s\n' "$listing" | LC_ALL=C sort | sha256sum | awk '{print $1}'
    return 0
  fi
  find "$mod" -maxdepth 4 -type f \( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' \) -print \
    | LC_ALL=C sort \
    | xargs stat -c '%n %Y %s' 2>/dev/null \
    | sha256sum | awk '{print $1}'
}

is_fresh() {
  local want="$1"
  [ -x "$bin" ] && [ -f "$stamp_file" ] && [ "$(cat "$stamp_file" 2>/dev/null || true)" = "$want" ]
}

ensure_writable_go_env() {
  local default_gocache="${GOCACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/go-build}"
  if ! (mkdir -p "$default_gocache" && [ -w "$default_gocache" ]) 2>/dev/null; then
    local uid=""
    uid="$(id -u)"
    export GOCACHE="${TMPDIR:-/tmp}/alt-harness-gocache-${uid}"
    mkdir -p "$GOCACHE" 2>/dev/null || return 1
    if [ -z "${GOPATH:-}" ] && [ ! -d "$HOME/go/pkg/mod" ]; then
      export GOPATH="${TMPDIR:-/tmp}/alt-harness-gopath-${uid}"
      mkdir -p "$GOPATH" 2>/dev/null || return 1
    fi
  fi
}

do_build() {
  local want="$1"
  if is_fresh "$want"; then
    return 0
  fi
  ensure_writable_go_env || return 1
  local tmp="$bin_dir/.alt-harness.tmp.$$"
  local stamp_tmp="$bin_dir/.alt-harness.stamp.tmp.$$"
  rm -f "$tmp" "$stamp_tmp"

  local tc="${GOTOOLCHAIN:-local}"
  local build_rc=0
  set +e
  (cd "$mod" && GOTOOLCHAIN="$tc" go build -mod=readonly -o "$tmp" ./cmd/alt-harness)
  build_rc=$?
  if [ "$build_rc" -ne 0 ] && [ -z "${GOTOOLCHAIN:-}" ]; then
    (cd "$mod" && GOTOOLCHAIN=auto go build -mod=readonly -o "$tmp" ./cmd/alt-harness)
    build_rc=$?
  fi
  set -e
  if [ "$build_rc" -ne 0 ]; then
    rm -f "$tmp" "$stamp_tmp"
    echo "ERROR: alt-harness build failed (rc=$build_rc)" >&2
    return 1
  fi
  chmod 0755 "$tmp" || { rm -f "$tmp" "$stamp_tmp"; return 1; }
  mv -f "$tmp" "$bin" || { rm -f "$tmp" "$stamp_tmp"; return 1; }
  printf '%s\n' "$want" >"$stamp_tmp" || { rm -f "$stamp_tmp"; return 1; }
  mv -f "$stamp_tmp" "$stamp_file" || { rm -f "$stamp_tmp"; return 1; }
}

ensure_writable_go_env || fail_exit "$@"
want_stamp="$(compute_stamp)"
if ! is_fresh "$want_stamp"; then
  if ! (mkdir -p "$bin_dir" && [ -w "$bin_dir" ]) 2>/dev/null; then
    mod_hash="$(printf '%s' "$mod" | sha256sum | cut -c1-12)"
    bin_dir="${TMPDIR:-/tmp}/alt-harness-bin-$(id -u)-${mod_hash}"
    bin="$bin_dir/alt-harness"
    stamp_file="$bin_dir/.alt-harness.stamp"
    lock_file="$bin_dir/.alt-harness.lock"
    mkdir -p "$bin_dir" 2>/dev/null || fail_exit "$@"
  fi
  if ! is_fresh "$want_stamp"; then
    if command -v flock >/dev/null 2>&1; then
      (
        flock -x 9
        want_locked="$(compute_stamp)"
        do_build "$want_locked"
      ) 9>"$lock_file" || fail_exit "$@"
    else
      do_build "$want_stamp" || fail_exit "$@"
    fi
  fi
fi

exec "$bin" "$@"
