  bq2: Nat,
  cr: Nat,
  h: ba + hb + tb = cfg_be_slots(cfg)
): BeConserved(
  cfg,
  step_result_state(dispatch_freed_rt_force(force_be, ra, hr, tr, ba, hb, tb, rq, bq2, cr))
) {
  match force_be {
    true => h
    false => match rq {
      Succ(rq2) => h
      Zero => h
    }
  }
}

pub theorem dispatch_freed_rt_be_conserved(
  cfg: Config,
  caller_prio: Priority,
  ra: Nat,
  hr: Nat,
  tr: Nat,
  ba: Nat,
  hb: Nat,
  tb: Nat,
  rq: Nat,
  bq: Nat,
  cr: Nat,
  h: ba + hb + tb = cfg_be_slots(cfg)
): BeConserved(
  cfg,
  step_result_state(dispatch_freed_rt(cfg, caller_prio, ra, hr, tr, ba, hb, tb, rq, bq, cr))
) {
  match cfg {
    SemConfig(rt_res, be_sl, max_d, ratio) => match ratio {
      Succ(rm) => match caller_prio {
        Rt => match bq {
          Succ(bq2) => dispatch_freed_rt_force_be_conserved(
            SemConfig(rt_res, be_sl, max_d, Succ(rm)),
            Nat::le(Succ(rm), Succ(cr)),
            ra,
            hr,
            tr,
            ba,
            hb,
            tb,
            rq,
            bq2,
            cr,
            h
          )
          Zero => match rq {
            Succ(rq2) => h
            Zero => h
          }
        }
        Be => match rq {
          Succ(rq2) => h
          Zero => match bq {
            Succ(bq2) => h
            Zero => h
          }
        }
      }
      Zero => match rq {
        Succ(rq2) => h
        Zero => match bq {
          Succ(bq2) => h
          Zero => h
        }
      }
    }
  }
}

