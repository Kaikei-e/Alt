// ============================================================================
// Pure Nat arithmetic helpers (zero axioms, zero holes)
// ============================================================================

pub theorem add_succ_mid(a: Nat, b: Nat, c: Nat): a + Succ(b) + c = a + b + Succ(c) {
  Nat::add_succ_left(a + b, c)
}

pub theorem add_succ_left_mid(a: Nat, b: Nat, c: Nat): Succ(a) + b + c = a + Succ(b) + c {
  Eq::congr(⟦□ + c⟧, Nat::add_succ_left(a, b))
}

pub theorem add_succ_left_right(a: Nat, b: Nat, c: Nat): Succ(a) + b + c = a + b + Succ(c) {
  Eq::trans(add_succ_left_mid(a, b, c), add_succ_mid(a, b, c))
}

pub theorem le_add_right(a: Nat, b: Nat): Nat::le(a, a + b) = true {
  match b {
    Zero => Nat::le_refl(a)
    Succ(k) => Nat::le_trans(a, a + k, Succ(a + k), le_add_right(a, k), Nat::le_succ(a + k))
  }
}

pub theorem le_add_left(a: Nat, b: Nat): Nat::le(b, a + b) = true {
  Eq::trans(Eq::congr(⟦Nat::le(b, □)⟧, Nat::add_comm(a, b)), le_add_right(b, a))
}

pub theorem le_add_mono(
  a1: Nat,
  b1: Nat,
  a2: Nat,
  b2: Nat,
  h1: Nat::le(a1, b1) = true,
  h2: Nat::le(a2, b2) = true
): Nat::le(a1 + a2, b1 + b2) = true {
  match a2 {
    Zero => match b2 {
      Zero => h1
      Succ(k) => Nat::le_trans(a1, b1, b1 + Succ(k), h1, le_add_right(b1, Succ(k)))
    }
    Succ(a2p) => match b2 {
      Zero => False::elim(false_ne_true(Eq::trans(Eq::sym(Nat::lt_zero_false(a2p)), h2)))
      Succ(b2p) => le_add_mono(a1, b1, a2p, b2p, h1, h2)
    }
  }
}

pub theorem le_of_eq(
  a: Nat,
  b: Nat,
  c: Nat,
  h_le: Nat::le(a, b) = true,
  h_eq: b = c
): Nat::le(a, c) = true {
  Eq::trans(Eq::congr(⟦Nat::le(a, □)⟧, Eq::sym(h_eq)), h_le)
}

pub theorem min_of_le(a: Nat, b: Nat, h: Nat::le(a, b) = true): Nat::min(a, b) = a {
  match a {
    Zero => match b {
      Zero => Refl
      Succ(_) => Refl
    }
    Succ(a2) => match b {
      Zero => False::elim(false_ne_true(Eq::trans(Eq::sym(Nat::lt_zero_false(a2)), h)))
      Succ(b2) => ⊢ Nat::min(Succ(a2), Succ(b2)) = Succ(a2) from match Nat::lt(a2, b2) eqn e {
        true => Eq::congr(
          (c: Bool) => ⊢ Nat from match c { false => Succ(b2), true => Succ(a2) },
          e
        )
        false => Eq::trans(
          Eq::congr((c: Bool) => ⊢ Nat from match c { false => Succ(b2), true => Succ(a2) }, e),
          Eq::congr(
            Succ,
            Eq::trans(
              Eq::congr((c: Bool) => ⊢ Nat from match c { false => b2, true => a2 }, Eq::sym(e)),
              min_of_le(a2, b2, h)
            )
          )
        )
      }
    }
  }
}

pub theorem eq_zero_of_add_zero_left(a: Nat, b: Nat, h: a + b = Zero): a = Zero {
  match b {
    Zero => h
    Succ(k) => False::elim(Nat::succ_ne_zero(a + k, h))
  }
}

pub theorem eq_zero_of_add_zero_right(a: Nat, b: Nat, h: a + b = Zero): b = Zero {
  match b {
    Zero => Refl
    Succ(k) => False::elim(Nat::succ_ne_zero(a + k, h))
  }
}

pub theorem triple_sum_zero(
  a: Nat,
  b: Nat,
  c: Nat,
  h: a + b + c = Zero
): a = Zero ∧ (b = Zero ∧ c = Zero) {
  let hc: c = Zero := eq_zero_of_add_zero_right(a + b, c, h)
  let hab: a + b = Zero := eq_zero_of_add_zero_left(a + b, c, h)
  AndIntro(eq_zero_of_add_zero_left(a, b, hab), AndIntro(eq_zero_of_add_zero_right(a, b, hab), hc))
}

pub theorem total_sum_rearrange(
  ra: Nat,
  hr: Nat,
  tr: Nat,
  ba: Nat,
  hb: Nat,
  tb: Nat
): (ra + ba) + (hr + hb) + (tr + tb) = (ra + hr + tr) + (ba + hb + tb) {
  Eq::trans(
    Eq::congr(⟦□ + (tr + tb)⟧, Nat::add_shuffle(ra, ba, hr, hb)),
    Nat::add_shuffle(ra + hr, ba + hb, tr, tb)
  )
}

// ============================================================================
// Invariant definitions
// ============================================================================

pub def RtConserved(cfg: Config, s: State): Prop :=
st_rt_avail(s) + st_held_rt(s) + st_in_transit_rt(s) = cfg_rt_reserved(cfg)

pub def BeConserved(cfg: Config, s: State): Prop :=
st_be_avail(s) + st_held_be(s) + st_in_transit_be(s) = cfg_be_slots(cfg)

pub def SlotInvariant(cfg: Config, s: State): Prop :=
RtConserved(cfg, s) ∧ BeConserved(cfg, s)

pub def TotalConserved(cfg: Config, s: State): Prop :=
st_total_avail(s) + st_total_held(s) + st_total_in_transit(s) = cfg_total_slots(cfg)

// ============================================================================
// Group 1: Per-pool and total slot conservation across ALL transitions
// ============================================================================

pub theorem init_rt_conserved(cfg: Config): RtConserved(cfg, init_state(cfg)) {
  match cfg {
    SemConfig(rt, be, depth, ratio) => Refl
  }
}

pub theorem init_be_conserved(cfg: Config): BeConserved(cfg, init_state(cfg)) {
  match cfg {
    SemConfig(rt, be, depth, ratio) => Refl
  }
}

pub theorem init_slot_invariant(cfg: Config): SlotInvariant(cfg, init_state(cfg)) {
  AndIntro(init_rt_conserved(cfg), init_be_conserved(cfg))
}

pub theorem enqueue_or_reject_if_rt_conserved(
  cfg: Config,
  is_full: Bool,
  s: State,
  prio: Priority,
  h: RtConserved(cfg, s)
): RtConserved(cfg, step_result_state(enqueue_or_reject_if(is_full, s, prio))) {
  match is_full {
    true => h
    false => match s {
      SemState(ra, hr, tr, ba, hb, tb, rq, bq, cr) => match prio { Rt => h, Be => h }
    }
  }
}

pub theorem enqueue_or_reject_rt_conserved(
  cfg: Config,
  s: State,
  prio: Priority,
  h: RtConserved(cfg, s)
): RtConserved(cfg, step_result_state(enqueue_or_reject(cfg, s, prio))) {
  enqueue_or_reject_if_rt_conserved(cfg, queue_is_full(cfg, s), s, prio, h)
}

pub theorem enqueue_or_reject_if_be_conserved(
  cfg: Config,
  is_full: Bool,
  s: State,
  prio: Priority,
  h: BeConserved(cfg, s)
): BeConserved(cfg, step_result_state(enqueue_or_reject_if(is_full, s, prio))) {
  match is_full {
    true => h
    false => match s {
      SemState(ra, hr, tr, ba, hb, tb, rq, bq, cr) => match prio { Rt => h, Be => h }
    }
  }
}

pub theorem enqueue_or_reject_be_conserved(
  cfg: Config,
  s: State,
  prio: Priority,
  h: BeConserved(cfg, s)
): BeConserved(cfg, step_result_state(enqueue_or_reject(cfg, s, prio))) {
  enqueue_or_reject_if_be_conserved(cfg, queue_is_full(cfg, s), s, prio, h)
}

pub theorem step_acquire_rt_conserved(
  cfg: Config,
  s: State,
  prio: Priority,
  h: RtConserved(cfg, s)
): RtConserved(cfg, step_result_state(step_acquire(cfg, s, prio))) {
  match cfg {
    SemConfig(rt_res, be_sl, max_d, ratio) => match s {
      SemState(ra, hr, tr, ba, hb, tb, rq, bq, cr) => match prio {
        Rt => match ra {
          Succ(r2) => Eq::trans(Eq::sym(add_succ_left_mid(r2, hr, tr)), h)
          Zero => match rt_res {
            Zero => match ba {
              Succ(b2) => h
              Zero => enqueue_or_reject_rt_conserved(
                SemConfig(Zero, be_sl, max_d, ratio),
                SemState(Zero, hr, tr, Zero, hb, tb, rq, bq, cr),
                Rt,
                h
              )
            }
            Succ(k) => enqueue_or_reject_rt_conserved(
              SemConfig(Succ(k), be_sl, max_d, ratio),
              SemState(Zero, hr, tr, ba, hb, tb, rq, bq, cr),
              Rt,
              h
            )
          }
        }
        Be => match ba {
          Succ(b2) => h
          Zero => match be_sl {
            Zero => match ra {
              Succ(r2) => Eq::trans(Eq::sym(add_succ_left_mid(r2, hr, tr)), h)
              Zero => enqueue_or_reject_rt_conserved(
                SemConfig(rt_res, Zero, max_d, ratio),
                SemState(Zero, hr, tr, Zero, hb, tb, rq, bq, cr),
                Be,
                h
              )
            }
            Succ(k) => enqueue_or_reject_rt_conserved(
              SemConfig(rt_res, Succ(k), max_d, ratio),
              SemState(ra, hr, tr, Zero, hb, tb, rq, bq, cr),
              Be,
              h
            )
          }
        }
      }
    }
  }
}

pub theorem step_acquire_be_conserved(
  cfg: Config,
  s: State,
  prio: Priority,
  h: BeConserved(cfg, s)
): BeConserved(cfg, step_result_state(step_acquire(cfg, s, prio))) {
  match cfg {
    SemConfig(rt_res, be_sl, max_d, ratio) => match s {
      SemState(ra, hr, tr, ba, hb, tb, rq, bq, cr) => match prio {
        Rt => match ra {
          Succ(r2) => h
          Zero => match rt_res {
            Zero => match ba {
              Succ(b2) => Eq::trans(Eq::sym(add_succ_left_mid(b2, hb, tb)), h)
              Zero => enqueue_or_reject_be_conserved(
                SemConfig(Zero, be_sl, max_d, ratio),
                SemState(Zero, hr, tr, Zero, hb, tb, rq, bq, cr),
                Rt,
                h
              )
            }
            Succ(k) => enqueue_or_reject_be_conserved(
              SemConfig(Succ(k), be_sl, max_d, ratio),
              SemState(Zero, hr, tr, ba, hb, tb, rq, bq, cr),
              Rt,
              h
            )
          }
        }
        Be => match ba {
          Succ(b2) => Eq::trans(Eq::sym(add_succ_left_mid(b2, hb, tb)), h)
          Zero => match be_sl {
            Zero => match ra {
              Succ(r2) => h
              Zero => enqueue_or_reject_be_conserved(
                SemConfig(rt_res, Zero, max_d, ratio),
                SemState(Zero, hr, tr, Zero, hb, tb, rq, bq, cr),
                Be,
                h
              )
            }
            Succ(k) => enqueue_or_reject_be_conserved(
              SemConfig(rt_res, Succ(k), max_d, ratio),
              SemState(ra, hr, tr, Zero, hb, tb, rq, bq, cr),
              Be,
              h
            )
          }
        }
      }
    }
  }
}

pub theorem dispatch_freed_rt_force_rt_conserved(
  cfg: Config,
  force_be: Bool,
  ra: Nat,
  hr: Nat,
  tr: Nat,
  ba: Nat,
  hb: Nat,
  tb: Nat,
  rq: Nat,
  bq2: Nat,
  cr: Nat,
  h_tr: ra + hr + Succ(tr) = cfg_rt_reserved(cfg)
): RtConserved(
  cfg,
  step_result_state(dispatch_freed_rt_force(force_be, ra, hr, tr, ba, hb, tb, rq, bq2, cr))
) {
  match force_be {
    true => h_tr
    false => match rq {
      Succ(rq2) => h_tr
      Zero => h_tr
    }
  }
}

pub theorem dispatch_freed_rt_rt_conserved(
  cfg: Config,
  caller_prio: Priority,
  ra: Nat,
  hr: Nat,
  tr: Nat,
  ba: Nat,
  hb: Nat,
  tb: Nat,
  rq: Nat,
  bq: Nat,
  cr: Nat,
  h: ra + Succ(hr) + tr = cfg_rt_reserved(cfg)
): RtConserved(
  cfg,
  step_result_state(dispatch_freed_rt(cfg, caller_prio, ra, hr, tr, ba, hb, tb, rq, bq, cr))
) {
  let h_tr: ra + hr + Succ(tr) = cfg_rt_reserved(cfg) := Eq::trans(
    Eq::sym(add_succ_mid(ra, hr, tr)),
    h
  )
  let h_ra: Succ(ra) + hr + tr = cfg_rt_reserved(cfg) := Eq::trans(add_succ_left_mid(ra, hr, tr), h)
  match cfg {
    SemConfig(rt_res, be_sl, max_d, ratio) => match ratio {
      Succ(rm) => match caller_prio {
        Rt => match bq {
          Succ(bq2) => dispatch_freed_rt_force_rt_conserved(
            SemConfig(rt_res, be_sl, max_d, Succ(rm)),
            Nat::le(Succ(rm), Succ(cr)),
            ra,
            hr,
            tr,
            ba,
            hb,
            tb,
            rq,
            bq2,
            cr,
            h_tr
          )
          Zero => match rq {
            Succ(rq2) => h_tr
            Zero => h_ra
          }
        }
        Be => match rq {
          Succ(rq2) => h_tr
          Zero => match bq {
            Succ(bq2) => h_tr
            Zero => h_ra
          }
        }
      }
      Zero => match rq {
        Succ(rq2) => h_tr
        Zero => match bq {
          Succ(bq2) => h_tr
          Zero => h_ra
        }
      }
    }
  }
}

