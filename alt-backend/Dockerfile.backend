# One build recipe for the binaries of the alt-backend module.
# `BINARY` selects ./cmd/<BINARY>:
#
#   BINARY=backend    alt-backend    user-facing API — :9000 REST / :9101 Connect
#                                    / :9102 internal / :9443 mTLS
#   BINARY=harvester  alt-harvester  scheduled jobs — :9110 operator listener only
#   BINARY=datahub    alt-data-hub   mTLS-only data plane — :9443, zero published ports
#   BINARY=notifier   alt-notifier   Web Push dispatcher — no listener, outbound only
#
# alt-notifier is a separate process rather than an eighth harvester job so that
# the VAPID private key is mounted into exactly one container, and so that
# `up{job="alt-notifier"}` plus its own restart counter answer "are notifications
# still going out" for free. A delivery path that stopped silently is the failure
# this feature is built around, and a multiplexed binary would hide it behind a
# process that is still up.
#
# Three Dockerfiles were rejected: the recipes drift independently (this repo
# has been burnt by build-recipe drift before), and each would get its own
# registry cache ref, so the `go mod download` layer — minutes on this module's
# dependency set — would be paid three times instead of once. Here that layer
# sits *above* `ARG BINARY`, so it has the same digest in all three images and
# the shared cache-from ref in .github/workflows/docker-build.yaml hits.
#
# L-001: base images are pinned to a patch version + sha256 digest. A floating
# tag produces a different artifact on every build; digest bumps happen
# deliberately alongside the CVE audit (M-001 govulncheck).
FROM golang:1.26-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS builder

WORKDIR /app

# Dependency cache layer. Placed before ARG BINARY on purpose — see above.
COPY ./app/go.mod ./app/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY ./app .

ARG BINARY
# No default, and no silent acceptance of an empty value (CLAUDE.md rule 9):
# an unset BINARY must be a build failure, not "whichever binary happens to
# come first". The directory check turns a typo into a build-time error with
# the list of valid targets instead of an image that runs the wrong process.
RUN test -n "${BINARY}" || { echo "BINARY build-arg is required (backend | harvester | datahub | notifier)" >&2; exit 1; }
RUN test -d "./cmd/${BINARY}" || { echo "no such command: ./cmd/${BINARY}" >&2; echo "available:" >&2; ls ./cmd >&2; exit 1; }

# Optimised build: symbols stripped, statically linked.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build \
      -ldflags="-s -w" \
      -o /out/app ./cmd/${BINARY}

# Minimal runtime (distroless/static) + non-root user.
# CA certificates and tzdata included, no shell.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:d093aa3e30dbadd3efe1310db061a14da60299baff8450a17fe0ccc514a16639

# Fixed path, not /${BINARY}: ENTRYPOINT's exec form does not expand ARGs, and
# a per-binary path would force each compose service to spell its own
# healthcheck command. One name keeps `test: ["CMD", "/app-entry",
# "healthcheck"]` identical across alt-backend, alt-harvester and alt-data-hub.
COPY --from=builder /out/app /app-entry

# The old image carried busybox's wget and /bin/sh purely so the compose
# healthcheck could run `wget --spider`. All three binaries implement a
# `healthcheck` subcommand instead, so the distroless runtime keeps its
# no-shell property. Do not reintroduce them.

# nonroot user (UID 65532)
USER nonroot:nonroot

# Documentation only; alt-data-hub publishes nothing and alt-harvester listens
# only on the operator port.
EXPOSE 9000

ENTRYPOINT ["/app-entry"]
