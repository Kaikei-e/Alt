{
  "consumer": {
    "name": "alt-backend"
  },
  "interactions": [
    {
      "description": "a BackfillDocumentOwners request from alt-backend",
      "providerStates": [
        {
          "name": "rag-orchestrator accepts document owner backfill"
        }
      ],
      "request": {
        "body": {
          "items": [
            {
              "article_id": "6f1a2f7e-1f1e-4c2a-9a3e-5b6c7d8e9f01",
              "user_id": "11111111-2222-3333-4444-555555555555"
            }
          ]
        },
        "headers": {
          "Authorization": "Bearer test-rag-api-token-minimum-24-characters-long",
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.items[*].article_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                }
              ]
            },
            "$.items[*].user_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                }
              ]
            }
          },
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/v1/documents/owners"
      },
      "response": {
        "body": {
          "already_set": 0,
          "not_found": 0,
          "updated": 1
        },
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        },
        "matchingRules": {
          "body": {
            "$.already_set": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.not_found": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.updated": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a RetrieveContext request from alt-backend",
      "providerStates": [
        {
          "name": "rag-orchestrator retrieves context for query with owner"
        }
      ],
      "request": {
        "body": {
          "candidate_article_ids": [
            "6f1a2f7e-1f1e-4c2a-9a3e-5b6c7d8e9f01"
          ],
          "query": "test search query",
          "user_id": "11111111-2222-3333-4444-555555555555"
        },
        "headers": {
          "Authorization": "Bearer test-rag-api-token-minimum-24-characters-long",
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.candidate_article_ids": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.query": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.user_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                }
              ]
            }
          },
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/v1/rag/retrieve"
      },
      "response": {
        "body": {
          "contexts": [
            {
              "chunk_id": "chunk-1",
              "chunk_text": "sample chunk text",
              "document_version": 1,
              "published_at": "2026-09-20T10:00:00Z",
              "score": 0.95,
              "title": "Test Article",
              "url": "https://example.com/article"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        },
        "matchingRules": {
          "body": {
            "$.contexts": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.contexts[*].chunk_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.contexts[*].chunk_text": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.contexts[*].document_version": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.contexts[*].published_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.contexts[*].score": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.contexts[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.contexts[*].url": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "an UpsertIndex request from alt-backend",
      "providerStates": [
        {
          "name": "rag-orchestrator accepts article upserts with owner"
        }
      ],
      "request": {
