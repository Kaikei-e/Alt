          "published_at": "2026-09-20T10:00:00Z",
          "title": "Test Article Title",
          "url": "https://example.com/article",
          "user_id": "11111111-2222-3333-4444-555555555555"
        },
        "headers": {
          "Authorization": "Bearer test-rag-api-token-minimum-24-characters-long",
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.article_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                }
              ]
            },
            "$.body": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.published_at": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.url": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.user_id": {
              "combine": "AND",
              "matchers": [
                {
