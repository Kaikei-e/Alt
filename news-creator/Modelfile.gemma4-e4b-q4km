# Google's Quantization-Aware Training 4-bit text GGUF (~5.15GB). The Ollama
# tag gemma4-e4b-q4km is kept for consumer env compatibility (PM-2026-016)
# even though the quantization is Q4_0, not Q4_K_M.
FROM /tmp/gguf/gemma-4-E4B_q4_0-it.gguf

# Multi-token prediction draft head, from ggml-org because Google's QAT repo
# ships none. The 8k / 12k tags inherit this layer through FROM.
DRAFT /tmp/gguf/mtp-gemma-4-E4B-it-Q4_0.gguf

TEMPLATE """{{- $system := "" }}
{{- range .Messages }}
{{- if eq .Role "system" }}
{{- if not $system }}{{ $system = .Content }}
{{- else }}{{ $system = printf "%s\n\n%s" $system .Content }}
{{- end }}
{{- continue }}
{{- else if eq .Role "user" }}<|turn>user
{{- if $system }}
{{ $system }}
{{- $system = "" }}
{{- end }}
{{- else if eq .Role "assistant" }}<|turn>model
{{- end }}
{{ .Content }}<turn|>
{{ end }}<|turn>model
"""

PARAMETER stop <turn|>
# Match gemma4-e4b-12k's num_ctx so a direct base-tag load never contends
# with the 12k tag over the shared Ollama runner (server default is 8192).
PARAMETER num_ctx 12288
