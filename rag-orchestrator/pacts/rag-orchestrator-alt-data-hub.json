{
  "consumer": {
    "name": "rag-orchestrator"
  },
  "interactions": [
    {
      "description": "a FetchArticlesByTag request from rag-orchestrator",
      "providerStates": [
        {
          "name": "alt-data-hub has articles tagged ai"
        }
      ],
      "request": {
        "body": {
          "limit": 10,
          "tagName": "ai"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/services.datahub.v1.DataHubService/FetchArticlesByTag"
      },
      "response": {
        "body": {
          "articles": [
            {
              "id": "article-1",
              "publishedAt": "2026-04-14T00:30:00Z",
              "title": "Multi-Agent Systems",
              "url": "https://example.com/mas"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.articles": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.articles[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.articles[*].publishedAt": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.articles[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.articles[*].url": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a FetchTagCloud request from rag-orchestrator",
      "providerStates": [
        {
          "name": "alt-data-hub has tagged articles"
        }
      ],
      "request": {
        "body": {
          "limit": 300
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/services.datahub.v1.DataHubService/FetchTagCloud"
      },
      "response": {
        "body": {
          "tags": [
            {
              "articleCount": 42,
              "tagName": "ai"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.tags": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.tags[*].articleCount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.tags[*].tagName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a ListRecentArticles request from rag-orchestrator with no count limit",
      "providerStates": [
        {
          "name": "alt-data-hub has articles published in the last 24 hours"
        }
      ],
      "request": {
        "body": {
          "limit": 0,
          "withinHours": 24
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/services.datahub.v1.DataHubService/ListRecentArticles"
      },
      "response": {
        "body": {
          "articles": [
            {
              "feedId": "11111111-2222-3333-4444-555555555555",
              "id": "6f1a2f7e-1f1e-4c2a-9a3e-5b6c7d8e9f01",
              "publishedAt": "2026-04-14T00:30:00Z",
              "tags": [
                "ai"
              ],
              "title": "An LLM primer",
              "url": "https://example.com/llm-primer"
            }
          ],
          "count": 1,
          "since": "2026-04-14T00:00:00Z",
          "until": "2026-04-15T00:00:00Z"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.articles": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.articles[*].feedId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                }
              ]
            },
            "$.articles[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                }
              ]
            },
            "$.articles[*].publishedAt": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.articles[*].tags": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.articles[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.articles[*].url": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.count": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.since": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.until": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-go": {
      "version": "2.5.1"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "mockserver": "1.2.16",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "alt-data-hub"
  }
}