{
  "consumer": {
    "name": "recap-worker"
  },
  "provider": {
    "name": "alt-data-hub"
  },
  "interactions": [
    {
      "description": "a BatchGetArticlesByIDs request from recap-worker",
      "request": {
        "method": "POST",
        "path": "/services.datahub.v1.DataHubService/BatchGetArticlesByIDs",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "articleIds": [
            "88888888-8888-8888-8888-888888888888"
          ]
        },
        "matchingRules": {
          "body": {
            "$.articleIds[*]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.articleIds[*].*": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.articleIds": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "articles": [
            {
              "id": "88888888-8888-8888-8888-888888888888",
              "content": "<p>Body content.</p>",
              "title": "Example Article",
              "publishedAt": "2026-11-18T09:00:00Z",
              "url": "https://example.com/articles/1"
            }
          ]
        },
        "matchingRules": {
          "body": {
            "$.articles[*].publishedAt": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.articles[*].url": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.articles[*].content": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.articles[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.articles": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.articles[*].*": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.articles[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        }
      },
      "providerStates": [
        {
          "name": "articles exist for the requested ids"
        }
      ]
    },
    {
      "description": "an EnqueueNotification request from the recap-worker outbox relay",
      "request": {
        "method": "POST",
        "path": "/services.datahub.v1.DataHubService/EnqueueNotification",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "dedupeKey": "recap:7d2a1c34-0a5f-4e51-9b1f-1a2b3c4d5e6f",
          "userId": "3f2504e0-4f89-11d3-9a0c-0305e82c3301",
          "payload": "eyJraW5kIjoicmVjYXBfcmVhZHkiLCJ1cmwiOiIvcmVjYXAifQ==",
          "kind": "recap_ready",
          "expiresAt": "2026-08-02T09:30:00.000000Z",
          "occurredAt": "2026-08-01T09:30:00.000000Z"
        },
        "matchingRules": {
          "body": {
            "$.payload": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.occurredAt": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.dedupeKey": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.expiresAt": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.userId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.kind": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "supersededCount": 0,
          "deliveryCount": 2
        },
        "matchingRules": {
          "body": {
            "$.deliveryCount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.supersededCount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        }
      },
      "providerStates": [
        {
          "name": "alt-data-hub accepts notification enqueues"
        }
      ]
    }
  ],
  "metadata": {
    "pactRust": {
      "consumer": "1.4.11",
