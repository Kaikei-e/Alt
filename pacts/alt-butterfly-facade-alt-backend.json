{
  "consumer": {
    "name": "alt-butterfly-facade"
  },
  "interactions": [
    {
      "description": "a BatchPrefetchArticleContent fire-and-forget warm proxied by BFF",
      "providerStates": [
        {
          "name": "article content prefetch is enabled"
        }
      ],
      "request": {
        "body": {
          "urls": [
            "https://example.com/next-article"
          ]
        },
        "headers": {
          "Content-Type": "application/json",
          "X-Alt-Backend-Token": "header.payload.signature"
        },
        "matchingRules": {
          "body": {
            "$.urls": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          },
          "header": {
            "X-Alt-Backend-Token": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/alt.articles.v2.ArticleService/BatchPrefetchArticleContent"
      },
      "response": {
        "body": {
          "acceptedCount": 2
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a Connect-RPC request that returns a not_found error",
      "providerStates": [
        {
          "name": "article does not exist"
        }
      ],
      "request": {
        "body": {
          "feedId": "nonexistent-feed"
        },
        "headers": {
          "Content-Type": "application/json",
          "X-Alt-Backend-Token": "header.payload.signature"
        },
        "matchingRules": {
          "body": {
            "$.feedId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "X-Alt-Backend-Token": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/alt.feeds.v2.FeedService/GetFeed"
      },
      "response": {
        "body": {
          "code": "not_found",
          "message": "feed not found"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 404
      }
    },
    {
      "description": "a GetFeedStats unary Connect-RPC request proxied by BFF",
      "providerStates": [
        {
          "name": "feed stats are available"
        }
      ],
      "request": {
        "body": {},
        "headers": {
          "Content-Type": "application/json",
          "X-Alt-Backend-Token": "header.payload.signature"
        },
        "matchingRules": {
          "header": {
            "X-Alt-Backend-Token": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/alt.feeds.v2.FeedService/GetFeedStats"
      },
      "response": {
        "body": {
          "totalArticles": 250,
          "totalFeeds": 10
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a GetProjectionHealth admin Connect-RPC request",
      "providerStates": [
        {
          "name": "knowledge home admin service is available"
        }
      ],
      "request": {
        "body": {},
        "headers": {
          "Authorization": "Bearer test-operator-token",
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/alt.knowledge_home.v1.KnowledgeHomeAdminService/GetProjectionHealth"
      },
      "response": {
        "body": {
          "activeVersion": 3,
          "lastUpdated": "2026-03-20T09:30:00Z"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-go": {
      "version": "2.5.1"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "mockserver": "1.2.16",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "alt-backend"
  }
}