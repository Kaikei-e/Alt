# syntax=docker/dockerfile:1

# Stage 1: Chef setup
FROM rust:1.99.1-bookworm@sha256:edaa2a8cc254d5936207af267114814c61cceea40b46eaa4e976068af55e20e7 AS chef
RUN cargo install cargo-chef --locked
WORKDIR /app

# Stage 2: Recipe generation
FROM chef AS planner
COPY ./recap-worker/ .
RUN cargo chef prepare --recipe-path recipe.json

# Stage 3: Dependency build (cached)
FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,id=recap-worker-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=recap-worker-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=recap-worker-target,target=/app/target,sharing=locked \
    cargo chef cook --release --recipe-path recipe.json

# Stage 4: Application build
COPY ./recap-worker/ .
RUN --mount=type=cache,id=recap-worker-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=recap-worker-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=recap-worker-target,target=/app/target,sharing=locked \
    cargo build --release --bin recap-worker && \
    cp target/release/recap-worker /app/recap-worker

# Stage 5: sentence-transformers model directory
#
# Read at runtime through SentenceEmbeddingsBuilder::local, so the image has to
# carry every file the loader opens. `::remote` is deliberately not used: it
# resolves each file through cached-path, which records no expiry and therefore
# revalidates against huggingface.co on every start — with a client built with
# no read timeout. One HEAD that connected and then went silent wedged startup
# for 16 hours before the listener was ever bound.
#
# 1_Pooling/config.json lives in a subdirectory: copy the directory, never a
# flat glob, or rust-bert panics inside Config::from_file with no named cause.
FROM debian:bookworm-slim AS model
ARG ST_REPO=https://huggingface.co/sentence-transformers/all-MiniLM-L12-v2/resolve/main
ARG MODEL_DIR=/opt/rustbert-models/all-MiniLM-L12-v2
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
RUN mkdir -p ${MODEL_DIR}/1_Pooling && \
    for f in modules.json config.json tokenizer_config.json \
             sentence_bert_config.json vocab.txt rust_model.ot; do \
      curl -fsSL --retry 5 --retry-delay 5 --max-time 900 \
        -o ${MODEL_DIR}/$f ${ST_REPO}/$f; \
    done && \
    curl -fsSL --retry 5 --retry-delay 5 --max-time 300 \
      -o ${MODEL_DIR}/1_Pooling/config.json ${ST_REPO}/1_Pooling/config.json && \
    # rust_model.ot is LFS-backed; a clone without LFS yields a ~130-byte
    # pointer file that fails later as an opaque tch load error.
    test "$(stat -c%s ${MODEL_DIR}/rust_model.ot)" -gt 100000000

# ランタイムイメージ (debian-slim + 非rootユーザー)
FROM debian:bookworm-slim

# 必要最小限の依存関係
RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  libssl3 \
  ca-certificates \
  && \
  rm -rf /var/lib/apt/lists/*

# 非rootユーザー作成。
# - uid/gid は 999 で明示固定する。host 側で bind-mount する
#   /opt/rustbert-cache の所有者を合わせる必要があり、暗黙に決まる
#   システム UID だと CI で chown 対象が読めない。
RUN groupadd -r -g 999 recap && useradd -r -u 999 -m -d /home/recap -g recap recap

# HuggingFace のキャッシュ配置を /opt/rustbert-cache に寄せる。
# このパスを compose から bind-mount することで、warmup 済みのモデル資源を
# 複数コンテナ・複数再起動にまたがって再利用する。Dockerfile 単体ビルド
# (bind-mount 無し) でも initial download が書けるよう、empty dir を作成して
# recap ユーザー所有にしておく。bind-mount 時はこの空ディレクトリが上書きされる。
ENV RUSTBERT_CACHE=/opt/rustbert-cache
ENV HF_HOME=/opt/rustbert-cache/huggingface
RUN mkdir -p /opt/rustbert-cache/huggingface && chown -R recap:recap /opt/rustbert-cache

COPY --from=builder /app/recap-worker /usr/local/bin/

# 評価用ゴールデンデータセット
RUN mkdir -p /app/data && chown recap:recap /app/data
COPY --from=builder --chown=recap:recap /app/tests/data/golden_classification.json /app/data/

# sentence-transformers weights, read at startup with
# SentenceEmbeddingsBuilder::local. Directory-scoped COPY: 1_Pooling/config.json
# is nested, and a flat glob that drops it fails as a bare panic inside
# Config::from_file rather than a named error.
COPY --from=model --chown=recap:recap /opt/rustbert-models/ /opt/rustbert-models/

USER recap

EXPOSE 9005

ENTRYPOINT ["/usr/local/bin/recap-worker"]
