# syntax=docker/dockerfile:1

# Stage 1: Chef setup
FROM rust:1.94-bookworm@sha256:6ae102bdbf528294bc79ad6e1fae682f6f7c2a6e6621506ba959f9685b308a55 AS chef
RUN cargo install cargo-chef --locked
WORKDIR /app

# Stage 2: Recipe generation
FROM chef AS planner
COPY ./recap-worker/ .
RUN cargo chef prepare --recipe-path recipe.json

# Stage 3: Dependency build (cached)
FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,id=recap-worker-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=recap-worker-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=recap-worker-target,target=/app/target,sharing=locked \
    cargo chef cook --release --recipe-path recipe.json

# Stage 4: Application build
COPY ./recap-worker/ .
RUN --mount=type=cache,id=recap-worker-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=recap-worker-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=recap-worker-target,target=/app/target,sharing=locked \
    cargo build --release --bin recap-worker && \
    cp target/release/recap-worker /app/recap-worker

# Stage 5: sentence-transformers model directory
#
# candle reads exactly these three files at startup, flat in one directory:
# config.json, tokenizer.json and model.safetensors. They are baked into the
# image so the runtime never talks to huggingface.co — the worker starts on an
# egress-less network and a hanging model fetch would wedge startup before the
# listener is bound.
#
# The revision is pinned to a commit, never `main`, and every file is verified
# with sha256 (A08:2025 Software & Data Integrity Failures / CWE-494). Digests
# were observed on 2026-09-04; update them together with ST_REVISION.
# model.safetensors is LFS-backed and a non-LFS fetch yields a ~130-byte
# pointer file — the checksum catches that too.
FROM debian:bookworm-slim AS model
ARG ST_REPO=https://huggingface.co/sentence-transformers/all-MiniLM-L12-v2/resolve
ARG ST_REVISION=a50ef00143b4d5391434df20ae11632588ac25be
ARG MODEL_DIR=/opt/models/all-MiniLM-L12-v2
ARG CONFIG_SHA256=bc451f333af67312ba0de5018ef1c9ba663cb18549443e568f0bd35262dc1c48
ARG TOKENIZER_SHA256=be50c3628f2bf5bb5e3a7f17b1f74611b2561a3a27eeab05e5aa30f411572037
ARG WEIGHTS_SHA256=d2d541e5f101695ae495eacd867a8d025ecfe8f9674fb23aa6cf93cdb60a5542
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
RUN mkdir -p ${MODEL_DIR} && \
    curl -fsSL --retry 5 --retry-delay 5 --max-time 300 \
      -o ${MODEL_DIR}/config.json "${ST_REPO}/${ST_REVISION}/config.json" && \
    curl -fsSL --retry 5 --retry-delay 5 --max-time 300 \
      -o ${MODEL_DIR}/tokenizer.json "${ST_REPO}/${ST_REVISION}/tokenizer.json" && \
    curl -fsSL --retry 5 --retry-delay 5 --max-time 900 \
      -o ${MODEL_DIR}/model.safetensors "${ST_REPO}/${ST_REVISION}/model.safetensors" && \
    printf '%s  %s\n' \
      "${CONFIG_SHA256}" "${MODEL_DIR}/config.json" \
      "${TOKENIZER_SHA256}" "${MODEL_DIR}/tokenizer.json" \
      "${WEIGHTS_SHA256}" "${MODEL_DIR}/model.safetensors" \
      > /tmp/model.sha256 && \
    sha256sum -c /tmp/model.sha256 && \
    rm /tmp/model.sha256

# Runtime image. debian-slim is kept because the CI smoke checks in
# docker-build.yaml run `ldd` through /bin/sh; distroless would need them
# rewritten.
FROM debian:bookworm-slim

RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  libssl3 \
  ca-certificates \
  && \
  rm -rf /var/lib/apt/lists/*

# Non-root user.
# - uid/gid are pinned to 999 because the host bind-mounts /opt/rustbert-cache
#   into this container and its owner has to match; an implicitly assigned
#   system UID leaves CI with nothing it can chown to.
# - -m materialises the home directory: without it hf-hub falls back to
#   $HOME/.cache/huggingface and panics with PermissionDenied.
RUN groupadd -r -g 999 recap && useradd -r -u 999 -m -d /home/recap -g recap recap

# hf-hub cache for the token counter. src/clients/token_counter.rs pulls the
# gated google/gemma-3-4b-it tokenizer through hf-hub, which caches under
# $HF_HOME. compose bind-mounts the host's /opt/rustbert-cache here (the path
# name is historical; production hosts already have it) so the download is
# shared across containers and restarts. The mount is rw because hf-hub
# rewrites lock and meta files even on a cache hit. An empty dir is created and
# chown'd so a plain `docker build` + `docker run` (no bind-mount) still works.
ENV HF_HOME=/opt/rustbert-cache/huggingface
RUN mkdir -p /opt/rustbert-cache/huggingface && chown -R recap:recap /opt/rustbert-cache

COPY --from=builder /app/recap-worker /usr/local/bin/

# 評価用ゴールデンデータセット
RUN mkdir -p /app/data && chown recap:recap /app/data
COPY --from=builder --chown=recap:recap /app/tests/data/golden_classification.json /app/data/

# sentence-transformers weights, loaded from disk at startup. `recap-worker
# warmup` loads exactly this directory and exits non-zero if anything is
# missing, which is what the CI smoke check runs.
COPY --from=model --chown=recap:recap /opt/models/ /opt/models/

USER recap

EXPOSE 9005

ENTRYPOINT ["/usr/local/bin/recap-worker"]
