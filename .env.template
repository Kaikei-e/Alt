# alt-backend deployment environment. One of: development | staging | production.
# An unrecognised value is rejected at startup rather than degrading to
# development.
APP_ENV=development

# alt-backend OGP image proxy. Enabled by default; when enabled it REQUIRES a
# non-empty secret or alt-backend exits non-zero at startup. Compose supplies
# it via IMAGE_PROXY_SECRET_FILE=/run/secrets/image_proxy_secret, backed by
# secrets/image_proxy_secret.txt. `altctl setup` generates that file (32 random
# bytes) along with every other required secret; the manual fallback for
# operators not using altctl is:
#   openssl rand -base64 32 > secrets/image_proxy_secret.txt
# The dev stack (compose/dev.yaml) needs neither — dev-secret-init generates
# secrets/dev_image_proxy_secret.txt inside the dev_secrets volume.
# Set IMAGE_PROXY_ENABLED=false to run without the image proxy explicitly.
IMAGE_PROXY_ENABLED=true

