# Knowledge Sovereign Event Listener Caller Authentication
# When enabled, knowledge-sovereign (:9500) enforces Bearer authentication against
# secrets/sovereign_event_token.txt. Clients (alt-backend, rag-orchestrator, recap-worker)
# present this token via SOVEREIGN_EVENT_TOKEN_FILE / RECAP_KNOWLEDGE_SOVEREIGN_TOKEN_FILE.
# Deploy order: deploy clients with the token secret first, then enable the provider gate.
# To run unauthenticated in development/staging, set *_AUTH=disabled explicitly.
# Production rejects disabled mode at startup.
# SOVEREIGN_EVENT_AUTH_MODE=disabled
# SOVEREIGN_EVENT_AUTH=disabled
# RECAP_KNOWLEDGE_SOVEREIGN_AUTH=disabled

# alt-backend Operator Listener Caller Authentication
# alt-backend's :9102 listener (KnowledgeHomeAdminService, AdminMonitorService) enforces
# Bearer authentication against secrets/backend_operator_token.txt. alt-butterfly-facade
# and altctl are the only intended callers; they present this token via
# BACKEND_OPERATOR_TOKEN_FILE / (altctl) --operator-token-file / ALTCTL_OPERATOR_TOKEN_FILE.
# Deploy order: deploy alt-butterfly-facade and altctl callers with the token secret first,
# then enable the alt-backend gate (it is enabled by default; there is no separate rollout step).
# To run unauthenticated in development/staging, set OPERATOR_AUTH=disabled explicitly on
# alt-backend (and BACKEND_OPERATOR_AUTH=disabled on alt-butterfly-facade, if it also runs).
# OPERATOR_TOKEN_FILE=secrets/backend_operator_token.txt
# OPERATOR_AUTH=disabled
# BACKEND_OPERATOR_AUTH=disabled

# recap-worker / recap-subworker Admin Surface Authentication
# recap-worker's /admin/jobs/retry + /admin/genre-learning and recap-subworker's
# /admin/* + /v1/runs enforce Bearer authentication against
# secrets/recap_admin_token.txt (recap-subworker has no caller other than
# recap-worker, so both sides share the one secret). recap-worker presents this
# token both to its own callers and when it calls recap-subworker.
# To run unauthenticated in development/staging, set RECAP_ADMIN_AUTH=disabled
# explicitly (compose passes it through to both services).
# RECAP_ADMIN_AUTH=disabled

# rag-orchestrator Plaintext Listener (:9010) Caller Authentication
# rag-orchestrator's :9010 REST listener enforces Bearer authentication against
# secrets/rag_api_token.txt so that X-Alt-User-Id is only accepted from authenticated
# callers. In Docker Compose, secrets/rag_api_token.txt is mounted as /run/secrets/rag_api_token.
# Clients (alt-backend, alt-harvester, rag_owner_backfill) present this token via
# RAG_API_TOKEN_FILE (or RAG_API_TOKEN).
# To run unauthenticated in development/staging, set RAG_API_AUTH=disabled explicitly.
# Production rejects disabled mode at startup.
# RAG_API_TOKEN_FILE=secrets/rag_api_token.txt
# RAG_API_AUTH=disabled

# Redis Streams & Cache Authentication
# When enabled in Docker Compose, secrets/redis_password.txt is mounted as /run/secrets/redis_password.
# In local development without Docker secrets, set REDIS_PASSWORD_FILE to point to your secret file.
# To run unauthenticated in development/staging, set REDIS_AUTH=disabled explicitly.
# Leaving both REDIS_PASSWORD_FILE and REDIS_AUTH unset is a fail-fast startup error in all Redis clients.
# REDIS_PASSWORD_FILE=secrets/redis_password.txt
# REDIS_AUTH=disabled

# East-West mTLS Client Certificate Verification & Peer Identity
# Go listeners (:9443) default to require_and_verify. No caller dials these
# :9443 ports today — every caller (alt-backend, rag-orchestrator, etc.) uses
# the plaintext ports — so require_and_verify effectively closes them until a
# caller with a client cert appears.
# To roll back any service to open anonymous TLS mode, set its *_MTLS_CLIENT_AUTH="".
SEARCH_INDEXER_MTLS_CLIENT_AUTH=require_and_verify
SEARCH_INDEXER_MTLS_ALLOWED_PEERS=alt-backend,rag-orchestrator,acolyte-orchestrator

PRE_PROCESSOR_MTLS_CLIENT_AUTH=require_and_verify
PRE_PROCESSOR_MTLS_ALLOWED_PEERS=alt-backend

AUTH_HUB_MTLS_CLIENT_AUTH=require_and_verify
AUTH_HUB_MTLS_ALLOWED_PEERS=alt-backend,alt-butterfly-facade,alt-data-hub

# alt-butterfly-facade :9443 listener stays closed by default: no code dials
# alt-butterfly-facade:9443 (alt-frontend-sv and the admin/admin-monitor
# proxies use plaintext :9250). ALT_BUTTERFLY_FACADE_MTLS_LISTEN is a
# service-specific override of the shared MTLS_LISTEN variable (which other
# services, e.g. auth-hub, still default to true) so flipping it on here
# never has to change with them.
# ALT_BUTTERFLY_FACADE_MTLS_LISTEN=false
# ALT_BUTTERFLY_FACADE_MTLS_CLIENT_AUTH=
# ALT_BUTTERFLY_FACADE_MTLS_ALLOWED_PEERS=

# Python services (:9443) peer allowlists and strict mode switches.
# The CN allowlist (*_MTLS_ALLOWED_PEERS) is enforced on every request that
# actually arrived over :9443, independent of strict: news-creator and
# recap-subworker check it in PeerIdentityMiddleware, tag-generator and
# acolyte-orchestrator close the TLS connection before the handshake ever
# reaches the app. /health and /metrics are exempt on all four.
# Strict mode remains false/disabled by default because it only gates the
# *plaintext* side (missing-peer 401 / header-trust path): plaintext callers
# (pre-processor, acolyte-orchestrator, rag-orchestrator, recap-evaluator)
# lack mTLS client certs, and certless probes (Docker health checks on
# localhost, Prometheus on recap-subworker:8002/metrics) reach the
# application middleware without client certificates.
NEWS_CREATOR_MTLS_ALLOWED_PEERS=recap-worker,acolyte-orchestrator,rag-orchestrator,recap-evaluator
# NEWS_CREATOR_PEER_IDENTITY_STRICT=false
# ACOLYTE_ORCHESTRATOR_PEER_IDENTITY_STRICT=false
# TAG_GENERATOR_MTLS_ALLOWED_PEERS=alt-butterfly-facade,alt-backend,search-indexer,recap-worker
# RECAP_SUBWORKER_MTLS_ALLOWED_PEERS=recap-worker

# Acolyte Legacy Report Ownership Backfill & Startup Gate
# When upgrading from pre-ownership schema, legacy reports carry user_id=NULL.
# The startup gate fails fast if unowned reports exist and no valid owner configuration
# is provided. Fresh/empty databases pass automatically without configuration.
# Option A (single-tenant / operator): assign all legacy reports to this UUID
# ACOLYTE_LEGACY_REPORT_OWNER_ID=
# Option B (multi-tenant): in-container path to JSON file mapping {"<report_id>": "<user_id>"}
# Note: when running under Docker Compose, mount the file into the container (e.g. - ./mapping.json:/etc/acolyte/legacy_mapping.json:ro)
# ACOLYTE_LEGACY_REPORT_MAPPING_FILE=
